---
/**
 * Photography — slowly changing photographs.
 * A single print whose image quietly crossfades between three scenes; a small
 * aperture turns in the corner.
 */
---

<svg
  class="painting painting--photo"
  viewBox="0 0 400 500"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="A photographic print whose image slowly changes between a horizon, hills, and a branch."
  fill="none"
>
  <defs>
    <clipPath id="clip-photo">
      <rect x="64" y="74" width="272" height="300" rx="2" />
    </clipPath>
  </defs>

  <!-- the print -->
  <rect x="52" y="62" width="296" height="356" rx="3" fill="var(--paper-raised)" stroke="var(--border)" stroke-width="2" />
  <rect x="64" y="74" width="272" height="300" rx="2" fill="var(--paper-sunk)" stroke="var(--ink-faint)" stroke-width="1" />

  <g clip-path="url(#clip-photo)" stroke-linecap="round" stroke-linejoin="round">
    <!-- scene A: horizon + sun -->
    <g class="scene" style="--i:0">
      <circle cx="250" cy="150" r="26" stroke="var(--ink-secondary)" stroke-width="2" />
      <line x1="64" y1="286" x2="336" y2="286" stroke="var(--ink)" stroke-width="2" />
      <path d="M96 250 q24 -14 48 0 q24 -14 48 0" stroke="var(--ink-faint)" stroke-width="1.6" />
    </g>
    <!-- scene B: hills -->
    <g class="scene" style="--i:1">
      <path d="M64 300 L150 196 L214 268 L286 188 L336 250 L336 374 L64 374 Z" fill="var(--paper-raised)" stroke="var(--ink)" stroke-width="2" />
      <circle cx="118" cy="132" r="18" stroke="var(--ink-faint)" stroke-width="1.6" />
    </g>
    <!-- scene C: a branch -->
    <g class="scene" style="--i:2">
      <path d="M84 360 C 160 320, 220 230, 312 132" stroke="var(--ink)" stroke-width="2.2" />
      <path d="M176 286 q26 -28 8 -52 M214 246 q34 -16 54 -2 M150 318 q-28 -10 -40 -34" stroke="var(--ink-secondary)" stroke-width="1.8" />
    </g>
  </g>

  <!-- aperture motif -->
  <g class="aperture" transform="translate(298 392)">
    <circle r="22" stroke="var(--ink-faint)" stroke-width="1.4" />
    <g stroke="var(--ink-secondary)" stroke-width="1.6">
      <line x1="0" y1="-16" x2="11" y2="-2" />
      <line x1="14" y1="6" x2="-2" y2="11" />
      <line x1="-12" y1="9" x2="-13" y2="-9" />
      <line x1="-9" y1="-13" x2="14" y2="-7" />
      <line x1="16" y1="0" x2="3" y2="14" />
      <line x1="-3" y1="16" x2="-15" y2="0" />
    </g>
  </g>
</svg>

<style>
  .painting {
    width: 100%;
    height: 100%;
  }
  .scene {
    opacity: 0;
  }
  /* with no motion, show the first scene */
  .scene[style*='--i:0'] {
    opacity: 1;
  }
  .aperture {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scene {
      animation: crossfade 16s ease-in-out infinite;
      animation-delay: calc(var(--i) * -5.33s);
    }
    .scene[style*='--i:0'] {
      opacity: 0;
      animation: crossfade 16s ease-in-out infinite;
    }
    .aperture {
      animation: turn 48s linear infinite;
    }
    @keyframes crossfade {
      0%,
      4% {
        opacity: 0;
      }
      10%,
      28% {
        opacity: 1;
      }
      36%,
      100% {
        opacity: 0;
      }
    }
    @keyframes turn {
      to {
        transform: rotate(360deg);
      }
    }
  }
</style>
