---
/**
 * Writing — a notebook page.
 * Ruled lines and a margin; lines of "handwriting" trace themselves on, hold,
 * and clear, as if the page is being written and turned.
 */
---

<svg
  class="painting painting--writing"
  viewBox="0 0 300 400"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="A ruled notebook page on which lines of handwriting slowly write themselves and clear."
  fill="none"
>
  <!-- ruled lines -->
  <g stroke="var(--border-faint)" stroke-width="1">
    <line x1="40" y1="104" x2="266" y2="104" />
    <line x1="40" y1="144" x2="266" y2="144" />
    <line x1="40" y1="184" x2="266" y2="184" />
    <line x1="40" y1="224" x2="266" y2="224" />
    <line x1="40" y1="264" x2="266" y2="264" />
    <line x1="40" y1="304" x2="266" y2="304" />
  </g>
  <!-- margin -->
  <line x1="62" y1="64" x2="62" y2="344" stroke="var(--accent)" stroke-width="1.2" opacity="0.55" />

  <!-- handwriting -->
  <g class="hand" stroke="var(--ink)" stroke-width="2" stroke-linecap="round">
    <path class="write" style="--d:0s" d="M72 100 q14 -7 26 0 t26 0 t26 0 t26 0 t26 0" pathLength="1" />
    <path class="write" style="--d:1.1s" d="M72 140 q12 -6 24 0 t24 0 t24 0 t24 0 t24 0 t20 0" pathLength="1" />
    <path class="write" style="--d:2.2s" d="M72 180 q14 -7 26 0 t26 0 t26 0 t26 0" pathLength="1" />
    <path class="write" style="--d:3.3s" d="M72 220 q12 -6 24 0 t24 0 t24 0 t24 0 t24 0" pathLength="1" />
    <path class="write" style="--d:4.4s" d="M72 260 q14 -7 26 0 t26 0 t26 0 t26 0 t26 0" pathLength="1" />
    <path class="write" style="--d:5.5s" d="M72 300 q12 -6 24 0 t24 0" pathLength="1" />
  </g>
</svg>

<style>
  .painting {
    width: 100%;
    height: 100%;
  }
  .write {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  /* with no motion, show the page already written */
  @media (prefers-reduced-motion: reduce) {
    .write {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .write {
      animation: write 13s var(--d, 0s) ease-in-out infinite;
    }
    @keyframes write {
      0% {
        stroke-dashoffset: 1;
        opacity: 1;
      }
      20%,
      70% {
        stroke-dashoffset: 0;
        opacity: 1;
      }
      86%,
      100% {
        stroke-dashoffset: 0;
        opacity: 0;
      }
    }
  }
</style>
