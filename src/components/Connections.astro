---
import ArticleCard from './ArticleCard.astro';
import type { ResolvedConnection } from '../lib/content';

interface Props {
  items: ResolvedConnection[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="connections" aria-labelledby="connections-head">
      <h2 id="connections-head" class="connections__head">
        <span class="eyebrow">Connections</span>
        <span class="connections__note">Where this piece threads into the rest of what's here</span>
      </h2>
      <ul class="connections__grid">
        {items.map(({ entry, gallery }) => (
          <li>
            <ArticleCard entry={entry} gallery={gallery} showSection />
          </li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .connections {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .connections__head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1.4rem;
  }
  .connections__note {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.98rem;
    color: var(--ink-secondary);
    letter-spacing: 0;
    text-transform: none;
  }
  .connections__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
</style>
