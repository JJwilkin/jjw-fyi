---
import ArticleCard from './ArticleCard.astro';
import type { ResolvedConnection } from '../lib/content';

interface Props {
  items: ResolvedConnection[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="connections" aria-labelledby="connections-head">
      <h2 id="connections-head">related</h2>
      <div class="connections__list">
        {items.map(({ entry, gallery }) => (
          <ArticleCard entry={entry} gallery={gallery} showSection />
        ))}
      </div>
    </aside>
  )
}

<style>
  .connections {
    margin-top: 1.75rem;
  }

  .connections h2 {
    margin-bottom: 1.75rem;
  }
</style>
