---
interface Props {
  text: string;
  description: string;
  src?: string;
}

const { text, description, src } = Astro.props;
---

<div class="briefing" data-audio-briefing>
  <div>
    <p class="briefing__eyebrow">Audio briefing</p>
    <p class="briefing__copy">{description}</p>
  </div>
  {
    src ? (
      <div class="briefing__player">
        <audio controls preload="metadata" src={src} aria-label="AI-generated audio briefing" />
        <p class="briefing__disclosure">AI-generated voice · Not a human recording</p>
      </div>
    ) : (
      <>
        <button type="button" data-briefing-button data-briefing-text={text}>
          <span aria-hidden="true" data-briefing-icon>▶</span>
          <span data-briefing-label>Listen</span>
        </button>
        <p class="sr-only" aria-live="polite" data-briefing-status />
      </>
    )
  }
</div>

<script>
  const briefingRoots = () =>
    document.querySelectorAll<HTMLElement>('[data-audio-briefing]');
  const audioPlayers = () => document.querySelectorAll<HTMLAudioElement>('[data-audio-briefing] audio');

  function resetBriefing(root: HTMLElement, message = '') {
    const button = root.querySelector<HTMLButtonElement>('[data-briefing-button]');
    const label = root.querySelector<HTMLElement>('[data-briefing-label]');
    const icon = root.querySelector<HTMLElement>('[data-briefing-icon]');
    const status = root.querySelector<HTMLElement>('[data-briefing-status]');

    if (button) button.dataset.playing = 'false';
    if (label) label.textContent = 'Listen';
    if (icon) icon.textContent = '▶';
    if (status) status.textContent = message;
  }

  function bindBriefings() {
    for (const root of briefingRoots()) {
      const audio = root.querySelector<HTMLAudioElement>('audio');
      if (audio && audio.dataset.bound !== 'true') {
        audio.dataset.bound = 'true';
        audio.addEventListener('play', () => {
          window.speechSynthesis?.cancel();
          for (const otherAudio of audioPlayers()) {
            if (otherAudio !== audio) otherAudio.pause();
          }
        });
      }

      const button = root.querySelector<HTMLButtonElement>('[data-briefing-button]');
      if (!button || button.dataset.bound === 'true') continue;
      button.dataset.bound = 'true';

      const canSpeak = 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
      if (!canSpeak) {
        button.disabled = true;
        resetBriefing(root, 'Audio briefings are not supported by this browser.');
        continue;
      }

      button.addEventListener('click', () => {
        if (button.dataset.playing === 'true') {
          window.speechSynthesis.cancel();
          resetBriefing(root, 'Briefing stopped.');
          return;
        }

        window.speechSynthesis.cancel();
        for (const audio of audioPlayers()) audio.pause();
        for (const otherRoot of briefingRoots()) resetBriefing(otherRoot);

        const utterance = new SpeechSynthesisUtterance(button.dataset.briefingText ?? '');
        const label = root.querySelector<HTMLElement>('[data-briefing-label]');
        const icon = root.querySelector<HTMLElement>('[data-briefing-icon]');
        const status = root.querySelector<HTMLElement>('[data-briefing-status]');

        utterance.rate = 0.96;
        utterance.onend = () => resetBriefing(root, 'Briefing finished.');
        utterance.onerror = () => resetBriefing(root, 'The briefing could not be played.');

        button.dataset.playing = 'true';
        if (label) label.textContent = 'Stop';
        if (icon) icon.textContent = '■';
        if (status) status.textContent = 'Playing the audio briefing.';
        window.speechSynthesis.speak(utterance);
      });
    }
  }

  document.addEventListener('astro:page-load', bindBriefings);
  document.addEventListener('astro:before-swap', () => window.speechSynthesis?.cancel());
  bindBriefings();
</script>

<style>
  .briefing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1rem 1.1rem;
    border-block: 1px solid var(--blue-pale);
    background: var(--paper-sunk);
  }

  .briefing p {
    margin: 0;
  }

  .briefing__eyebrow {
    color: var(--blue);
    font-family: var(--font-ui);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .briefing__copy {
    margin-top: 0.35rem !important;
    color: var(--ink-secondary);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .briefing button {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 0.55rem;
    min-width: 6.5rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--blue);
    background: var(--paper-raised);
    color: var(--blue-deep);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .briefing button:hover {
    background: var(--paper);
  }

  .briefing button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .briefing__player {
    flex: none;
    width: min(100%, 19rem);
  }

  .briefing__player audio {
    display: block;
    width: 100%;
    height: 2.5rem;
  }

  .briefing__disclosure {
    margin-top: 0.35rem !important;
    color: var(--ink-faint);
    font-family: var(--font-ui);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .briefing {
      align-items: stretch;
      flex-direction: column;
    }

    .briefing button {
      justify-content: center;
      width: 100%;
      min-height: 2.75rem;
    }

    .briefing__player {
      width: 100%;
    }

    .briefing__disclosure {
      text-align: left;
    }
  }
</style>
