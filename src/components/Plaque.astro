---
import type { Gallery } from '../data/galleries';
import { galleryUrl, formatFullDate, isoDate } from '../lib/content';

interface Props {
  title: string;
  medium: string;
  date: Date;
  summary: string;
  tags?: string[];
  gallery: Gallery | undefined;
}

const { title, date, summary, tags = [], gallery } = Astro.props;
---

<header class="plaque">
  <h1 class="plaque__title">{title}</h1>

  <p class="plaque__meta">
    <time datetime={isoDate(date)}>{formatFullDate(date)}</time>
    {
      gallery && (
        <>
          &nbsp;│ <a href={galleryUrl(gallery.slug)}>{gallery.title.toLowerCase()}</a>
        </>
      )
    }
    {tags.length > 0 && <> · {tags.join(', ')}</>}
  </p>

  <p class="plaque__summary">{summary}</p>
</header>

<style>
  .plaque {
    padding-top: 0.875rem;
  }

  .plaque__title {
    margin: 0 0 0.875rem;
    font-family: var(--font-body);
    font-size: clamp(2rem, 7vw, 2.5rem);
    letter-spacing: 0;
    line-height: 1.12;
  }

  .plaque__meta {
    margin: 0 0 1.75rem;
    color: var(--ink-secondary);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .plaque__summary {
    margin: 0 0 1.75rem;
    color: var(--ink-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
  }
</style>
