---
import {
  photoFullImageUrl,
  photoImageSrcset,
  photoImageUrl,
  type PhotoCollection,
} from '../data/photoCollections';

interface Props {
  collection: PhotoCollection;
}

const { collection } = Astro.props;
---

<article class="photo-essay">
  <header class="essay-head">
    <div>
      <p class="essay-head__meta">
        Photo collection · {collection.location} · {collection.date}
      </p>
      <h1>{collection.title}</h1>
    </div>
    <p class="essay-head__note">
      {collection.note} Select any photograph to open the collection.
    </p>
  </header>

  <section
    class={`photo-wall photo-wall--${collection.layout}`}
    aria-label={`${collection.title} photo collection`}
  >
    {
      collection.photos.map((photo, index) => (
        <figure class="photo-card">
          <button
            type="button"
            class="photo-card__open"
            aria-label={`Open photo ${index + 1}: ${photo.caption}`}
            data-gallery-item
            data-index={index}
            data-full={photoFullImageUrl(photo.id, 2000)}
            data-alt={photo.alt}
            data-caption={photo.caption}
          >
            <img
              src={photoImageUrl(photo.id, 1400)}
              srcset={photoImageSrcset(photo.id)}
              sizes="(max-width: 760px) 100vw, 60vw"
              alt={photo.alt}
              loading={index < 2 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              style={`object-position:${photo.position ?? 'center'}`}
            />
            <span class="photo-card__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
          </button>
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))
    }
  </section>

  <footer class="essay-end">
    <p>
      {collection.photos.length} photographs · {collection.location} · {collection.date}
    </p>
    <p><a href="/photos/">← All photo collections</a></p>
  </footer>
</article>

<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <div class="lightbox__stage">
    <button class="lightbox__close" type="button" aria-label="Close photo viewer" data-lightbox-close>
      Close
    </button>

    <button class="lightbox__arrow lightbox__arrow--previous" type="button" aria-label="Previous photo" data-lightbox-previous>
      ←
    </button>

    <figure class="lightbox__figure">
      <img data-lightbox-image alt="" />
      <figcaption>
        <span data-lightbox-caption></span>
        <span data-lightbox-count></span>
      </figcaption>
    </figure>

    <button class="lightbox__arrow lightbox__arrow--next" type="button" aria-label="Next photo" data-lightbox-next>
      →
    </button>
  </div>
</dialog>

<script is:inline>
  function bindPhotoCollection() {
    const dialog = document.querySelector('[data-lightbox]');
    if (!(dialog instanceof HTMLDialogElement) || dialog.dataset.bound === 'true') return;

    const items = [...document.querySelectorAll('[data-gallery-item]')];
    const image = dialog.querySelector('[data-lightbox-image]');
    const caption = dialog.querySelector('[data-lightbox-caption]');
    const count = dialog.querySelector('[data-lightbox-count]');
    const close = dialog.querySelector('[data-lightbox-close]');
    const previous = dialog.querySelector('[data-lightbox-previous]');
    const next = dialog.querySelector('[data-lightbox-next]');
    if (!(image instanceof HTMLImageElement) || !caption || !count || !close || !previous || !next) return;

    dialog.dataset.bound = 'true';
    let activeIndex = 0;
    let touchStartX = null;

    function showPhoto(index) {
      activeIndex = (index + items.length) % items.length;
      const item = items[activeIndex];
      image.src = item.dataset.full;
      image.alt = item.dataset.alt;
      caption.textContent = item.dataset.caption;
      count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
    }

    for (const item of items) {
      item.addEventListener('click', () => {
        showPhoto(Number(item.dataset.index));
        dialog.showModal();
      });
    }

    close.addEventListener('click', () => dialog.close());
    previous.addEventListener('click', () => showPhoto(activeIndex - 1));
    next.addEventListener('click', () => showPhoto(activeIndex + 1));

    dialog.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.lightbox__figure img, .lightbox__figure figcaption, button')) return;
      dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showPhoto(activeIndex - 1);
      if (event.key === 'ArrowRight') showPhoto(activeIndex + 1);
    });

    dialog.addEventListener(
      'touchstart',
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? null;
      },
      { passive: true },
    );

    dialog.addEventListener(
      'touchend',
      (event) => {
        if (touchStartX === null) return;
        const distance = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
        if (Math.abs(distance) > 45) showPhoto(activeIndex + (distance < 0 ? 1 : -1));
        touchStartX = null;
      },
      { passive: true },
    );
  }

  document.addEventListener('astro:page-load', bindPhotoCollection);
  bindPhotoCollection();
</script>

<style>
  .photo-essay {
    padding-top: 0;
  }

  .essay-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    align-items: end;
    gap: clamp(50px, 9vw, 150px);
    padding: 34px 42px 44px;
  }

  .essay-head__meta {
    margin: 0 0 16px;
    color: var(--blue);
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .essay-head h1 {
    max-width: 11ch;
    font-size: clamp(52px, 6vw, 78px);
    line-height: 0.96;
    overflow-wrap: normal;
  }

  .essay-head__note {
    max-width: 38ch;
    margin: 0 0 4px;
    color: var(--ink-secondary);
    font-size: 18px;
    font-weight: 300;
    line-height: 1.6;
  }

  .photo-wall {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    grid-auto-rows: clamp(54px, 5vw, 78px);
    gap: 6px;
  }

  .photo-card {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
  }

  .photo-wall--hero-grid .photo-card:nth-child(1) {
    grid-column: 1 / 7;
    grid-row: 1 / span 6;
  }

  .photo-wall--hero-grid .photo-card:nth-child(2) {
    grid-column: 7 / 10;
    grid-row: 1 / span 3;
  }

  .photo-wall--hero-grid .photo-card:nth-child(3) {
    grid-column: 10 / 13;
    grid-row: 1 / span 3;
  }

  .photo-wall--hero-grid .photo-card:nth-child(4) {
    grid-column: 7 / 13;
    grid-row: 4 / span 3;
  }

  .photo-wall--hero-grid .photo-card:nth-child(5) {
    grid-column: 1 / 7;
    grid-row: 7 / span 4;
  }

  .photo-wall--hero-grid .photo-card:nth-child(6) {
    grid-column: 7 / 13;
    grid-row: 7 / span 4;
  }

  .photo-wall--film-strip .photo-card:nth-child(1) {
    grid-column: 1 / 9;
    grid-row: 1 / span 6;
  }

  .photo-wall--film-strip .photo-card:nth-child(2) {
    grid-column: 9 / 13;
    grid-row: 1 / span 6;
  }

  .photo-wall--film-strip .photo-card:nth-child(3) {
    grid-column: 1 / 5;
    grid-row: 7 / span 4;
  }

  .photo-wall--film-strip .photo-card:nth-child(4) {
    grid-column: 5 / 13;
    grid-row: 7 / span 4;
  }

  .photo-wall--diptych .photo-card:nth-child(1) {
    grid-column: 1 / 8;
    grid-row: 1 / span 7;
  }

  .photo-wall--diptych .photo-card:nth-child(2) {
    grid-column: 8 / 13;
    grid-row: 1 / span 7;
  }

  .photo-card__open {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: var(--paper-sunk);
    color: inherit;
    cursor: zoom-in;
  }

  .photo-card__open img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease, filter 350ms ease;
  }

  .photo-card__open:hover img {
    filter: saturate(0.92);
    transform: scale(1.015);
  }

  .photo-card__number {
    position: absolute;
    top: 8px;
    right: 9px;
    padding: 3px 6px;
    background: rgba(251, 250, 246, 0.88);
    color: var(--blue-deep);
    font-family: var(--font-ui);
    font-size: 9px;
    line-height: 1;
  }

  .photo-card figcaption {
    position: absolute;
    z-index: 1;
    bottom: 8px;
    left: 8px;
    max-width: calc(100% - 16px);
    margin: 0;
    padding: 3px 6px;
    background: rgba(251, 250, 246, 0.9);
    color: var(--blue-deep);
    font-family: var(--font-ui);
    font-size: 8px;
    line-height: 1.35;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .photo-card:hover figcaption {
    opacity: 1;
    transform: translateY(0);
  }

  .essay-end {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    margin-top: 0;
    padding: 24px 42px 28px;
    border-top: 1px solid var(--blue);
    color: var(--ink-faint);
    font-family: var(--font-ui);
    font-size: 10px;
    line-height: 1.5;
  }

  .essay-end p {
    margin: 0;
  }

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 17, 35, 0.97);
    color: var(--paper);
  }

  .lightbox::backdrop {
    background: rgba(10, 17, 35, 0.97);
  }

  .lightbox__stage {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: 70px minmax(0, 1fr) 70px;
    align-items: center;
    padding: 60px 28px 30px;
  }

  .lightbox__figure {
    display: grid;
    min-width: 0;
    height: 100%;
    margin: 0;
    grid-template-rows: minmax(0, 1fr) auto;
    place-items: center;
  }

  .lightbox__figure img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100dvh - 130px);
    object-fit: contain;
  }

  .lightbox__figure figcaption {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 24px;
    padding-top: 16px;
    color: var(--blue-pale);
    font-family: var(--font-ui);
    font-size: 11px;
    line-height: 1.5;
  }

  .lightbox__close,
  .lightbox__arrow {
    border: 0;
    background: transparent;
    color: var(--paper);
    font-family: var(--font-ui);
    cursor: pointer;
  }

  .lightbox__close {
    position: absolute;
    top: 22px;
    right: 26px;
    padding: 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lightbox__arrow {
    padding: 20px;
    font-size: 30px;
  }

  @media (max-width: 760px) {
    .photo-essay {
      padding-top: 0;
    }

    .essay-head {
      display: block;
      margin: 0;
      padding: 24px 22px 30px;
    }

    .essay-head h1 {
      font-size: 42px;
      line-height: 1.02;
    }

    .essay-head__note {
      max-width: 32ch;
      margin-top: 20px;
      font-size: 15px;
    }

    .photo-wall {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 82px;
      gap: 5px;
    }

    .photo-wall .photo-card:nth-child(1) {
      grid-column: 1 / -1;
      grid-row: auto / span 3;
    }

    .photo-wall .photo-card:nth-child(2) {
      grid-column: 1 / span 2;
      grid-row: auto / span 3;
    }

    .photo-wall .photo-card:nth-child(3) {
      grid-column: 3 / span 2;
      grid-row: auto / span 3;
    }

    .photo-wall .photo-card:nth-child(4) {
      grid-column: 1 / -1;
      grid-row: auto / span 3;
    }

    .photo-wall .photo-card:nth-child(5) {
      grid-column: 1 / span 2;
      grid-row: auto / span 3;
    }

    .photo-wall .photo-card:nth-child(6) {
      grid-column: 3 / span 2;
      grid-row: auto / span 3;
    }

    .photo-wall--diptych .photo-card:nth-child(1) {
      grid-column: 1 / span 2;
      grid-row: auto / span 4;
    }

    .photo-wall--diptych .photo-card:nth-child(2) {
      grid-column: 3 / span 2;
      grid-row: auto / span 4;
    }

    .photo-card figcaption {
      right: 6px;
      bottom: 6px;
      left: 6px;
      max-width: max-content;
      font-size: 7px;
    }

    .photo-card__number {
      top: 6px;
      right: 6px;
      font-size: 8px;
    }

    .essay-end {
      display: block;
      margin-top: 0;
      padding: 20px 22px 24px;
    }

    .essay-end p + p {
      margin-top: 8px;
    }

    .lightbox__stage {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) 54px;
      gap: 8px;
      padding: 56px 16px 12px;
    }

    .lightbox__figure {
      grid-column: 1 / -1;
    }

    .lightbox__figure img {
      max-height: calc(100dvh - 170px);
    }

    .lightbox__figure figcaption {
      font-size: 9px;
    }

    .lightbox__arrow {
      grid-row: 2;
      padding: 8px;
      border-top: 1px solid rgba(183, 196, 224, 0.3);
      font-size: 24px;
    }

    .lightbox__arrow--previous {
      grid-column: 1;
    }

    .lightbox__arrow--next {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card__open img,
    .photo-card figcaption {
      transition: none;
    }
  }
</style>
