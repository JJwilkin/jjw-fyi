---
import type { Gallery } from '../data/galleries';
import { articleUrl, formatMonthYear, isoDate, type Article } from '../lib/content';

interface Props {
  entry: Article;
  gallery: Gallery | undefined;
  /** Show the section name (useful when cards mix sections, e.g. connections). */
  showSection?: boolean;
}

const { entry, gallery, showSection = false } = Astro.props;
const { title, summary, medium, date, number } = entry.data;
---

<a class="card" href={articleUrl(entry)}>
  <div class="card__head">
    <span class="eyebrow">{showSection && gallery ? gallery.title : medium}</span>
    <span class="card__no">№{String(number).padStart(3, '0')}</span>
  </div>
  <h3 class="card__title">{title}</h3>
  <p class="card__summary">{summary}</p>
  <time class="card__date" datetime={isoDate(date)}>{formatMonthYear(date)}</time>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem 1.2rem;
    transition:
      border-color 160ms var(--ease),
      transform 160ms var(--ease),
      box-shadow 160ms var(--ease);
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--ink-faint);
    transform: translateY(-2px);
    box-shadow: 0 14px 26px -18px rgba(40, 34, 24, 0.4);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .card__no {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .card__title {
    font-size: 1.18rem;
    line-height: 1.22;
    margin: 0.5rem 0 0;
  }
  .card:hover .card__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.16em;
  }

  .card__summary {
    margin: 0.5rem 0 0;
    font-size: 0.96rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .card__date {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    margin-top: 0.9rem;
  }
</style>
