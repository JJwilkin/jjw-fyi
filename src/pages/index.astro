---
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from '../components/Frame.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { galleries, getGallery } from '../data/galleries';
import { getArticles } from '../lib/content';

const articles = await getArticles();
const articleTitlesByGallery = new Map(
  galleries.map((gallery) => [
    gallery.slug,
    articles.filter((article) => article.data.gallery === gallery.slug).map((article) => article.data.title),
  ])
);

const recent = articles.slice(0, 4);
---

<BaseLayout width="full">
  <section class="entrance measure-full">
    <p class="entrance__eyebrow eyebrow">Joshua Wilkinson</p>
    <h1 class="entrance__statement">This is how I see and think about the world.</h1>
    <p class="entrance__lede">
      Writing on systems and software, alongside photographs, field notes, walks and
      half-finished thoughts. None of it sits in its own silo — pick a section below, or open the
      <a href="/map/">Map of Curiosity</a> to see how it all connects.
    </p>
  </section>

  <section class="wall measure-full" aria-label="Sections">
    {
      galleries.map((g) => (
        <Frame gallery={g} articleTitles={articleTitlesByGallery.get(g.slug) ?? []} />
      ))
    }
  </section>

  {
    recent.length > 0 && (
      <section class="recent measure-full" aria-labelledby="recent-head">
        <h2 id="recent-head" class="recent__head">
          <span class="eyebrow">Latest</span>
          <span class="recent__note">Recently published</span>
        </h2>
        <ul class="recent__grid">
          {recent.map((entry) => (
            <li>
              <ArticleCard entry={entry} gallery={getGallery(entry.data.gallery)} showSection />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .entrance {
    padding-top: clamp(2.4rem, 6vw, 4rem);
    padding-bottom: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 54rem;
  }
  .entrance__statement {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1.9rem, 1.2rem + 3.4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0.5rem 0 0;
    text-wrap: balance;
  }
  .entrance__lede {
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.22rem);
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 46ch;
  }

  .wall {
    column-count: 3;
    column-gap: clamp(1rem, 2.4vw, 1.8rem);
    --wall-gap: clamp(1rem, 2.4vw, 1.8rem);
    padding-top: 0.5rem;
  }
  @media (max-width: 60rem) {
    .wall {
      column-count: 2;
    }
  }
  @media (max-width: 34rem) {
    .wall {
      column-count: 1;
    }
  }

  .recent {
    margin-top: clamp(2.6rem, 6vw, 4.5rem);
  }
  .recent__head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1.4rem;
  }
  .recent__note {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.98rem;
    color: var(--ink-secondary);
  }
  .recent__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
</style>
