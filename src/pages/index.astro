---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGallery } from '../data/galleries';
import {
  articleUrl,
  formatDotDate,
  getArticles,
  isoDate,
  readingMinutes,
  tagSlug,
} from '../lib/content';

const articles = (await getArticles()).filter((article) => article.data.gallery !== 'research');
const topics = [...new Set(articles.flatMap((article) => article.data.tags))]
  .map((tag) => ({
    name: tag,
    count: articles.filter((article) => article.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 7);
---

<BaseLayout>
  <div class="home">
    <section class="feed" aria-label="Recent writing" data-feed>
      <header class="preamble">
        <p>
          I'm Josh, I am a software engineer by trade and enjoy spending time taking photographs
          and writing down my thoughts and philosophies.
        </p>
      </header>
      {
        articles.length > 0 ? (
          articles.map((entry) => {
            const gallery = getGallery(entry.data.gallery);
            const tags =
              entry.data.tags.length > 0
                ? entry.data.tags
                : [gallery?.title ?? entry.data.medium];

            return (
              <article class="post" data-feed-item>
                <div class="post__meta">
                  <time datetime={isoDate(entry.data.date)}>{formatDotDate(entry.data.date)}</time>
                  <span class="post__tags">
                    {tags.map((tag) => (
                      <a href={`/tags/?tag=${encodeURIComponent(tagSlug(tag))}`}>{tag}</a>
                    ))}
                  </span>
                </div>
                <h2><a href={articleUrl(entry)}>{entry.data.title}</a></h2>
                <p>{entry.data.summary}</p>
                <a class="post__read" href={articleUrl(entry)}>
                  Read → {readingMinutes(entry)} min
                </a>
              </article>
            );
          })
        ) : (
          <div class="empty">
            <p>Nothing published yet.</p>
          </div>
        )
      }
      {
        articles.length > 5 && (
          <button class="feed__more" type="button" data-show-more hidden>Show more</button>
        )
      }
    </section>

    <aside class="sidebar">
      <section>
        <h2>Now</h2>
        <p>Building software and writing about systems, tools, and the ideas behind the work.</p>
      </section>

      <section>
        <h2>Topics</h2>
        {
          topics.length > 0 ? (
            <div class="topics">
              {topics.map((topic) => (
                <a href={`/tags/?tag=${encodeURIComponent(topic.name.toLowerCase())}`}>
                  {topic.name.toLowerCase()} · {topic.count}
                </a>
              ))}
            </div>
          ) : (
            <p class="topics__empty">Tags will appear here with the first post.</p>
          )
        }
      </section>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  function bindArticleFeed() {
    const feed = document.querySelector('[data-feed]');
    if (!feed || feed.dataset.bound === 'true') return;
    feed.dataset.bound = 'true';

    const items = [...feed.querySelectorAll('[data-feed-item]')];
    const button = feed.querySelector('[data-show-more]');
    const pageSize = 5;
    let visible = pageSize;

    if (!button || items.length <= pageSize) return;

    function updateFeed() {
      for (const [index, item] of items.entries()) item.hidden = index >= visible;

      const remaining = Math.max(0, items.length - visible);
      button.hidden = remaining === 0;
      button.textContent = remaining > 0 ? `Show more · ${remaining} remaining` : 'All articles shown';
    }

    button.addEventListener('click', () => {
      visible = Math.min(items.length, visible + pageSize);
      updateFeed();
    });

    updateFeed();
  }

  document.addEventListener('astro:page-load', bindArticleFeed);
  bindArticleFeed();
</script>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 64px;
    padding-top: 44px;
  }

  .preamble {
    padding-bottom: 30px;
    border-bottom: 1px solid var(--blue);
  }

  .preamble p {
    max-width: 57ch;
    margin: 0;
    color: var(--ink-secondary);
    font-size: 19px;
    font-weight: 300;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 30px 0;
    border-bottom: 1px solid var(--border);
  }

  .post:first-child {
    padding-top: 0;
  }

  .post:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .post__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 14px;
    color: var(--ink-faint);
    font-family: var(--font-ui);
    font-size: 10px;
    line-height: 1;
  }

  .post__meta a {
    color: var(--blue);
    text-transform: lowercase;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
  }

  .post__tags a + a::before {
    content: '·';
    display: inline-block;
    margin: 0 10px;
    color: var(--ink-faint);
  }

  .post h2 {
    font-size: 30px;
    line-height: 1.22;
  }

  .post h2 a {
    color: var(--ink);
  }

  .post p {
    max-width: 52ch;
    margin: 0;
    color: var(--ink-secondary);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.66;
    text-wrap: pretty;
  }

  .post__read {
    align-self: flex-start;
    font-family: var(--font-ui);
    font-size: 11px;
    line-height: 1;
  }

  .feed__more {
    width: 100%;
    margin-top: 20px;
    padding: 13px 16px;
    border: 1px solid var(--blue-pale);
    background: transparent;
    color: var(--blue);
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .feed__more:hover {
    border-color: var(--blue);
    background: var(--paper-sunk);
  }

  .empty p {
    margin-bottom: 0.5rem;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    color: var(--ink-secondary);
  }

  .sidebar section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar h2 {
    color: var(--ink-faint);
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .sidebar p {
    margin: 0;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
  }

  .topics {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: var(--font-ui);
    font-size: 11px;
    line-height: 1.7;
  }

  .topics__empty {
    color: var(--ink-faint);
  }

  @media (max-width: 760px) {
    .home {
      display: block;
      padding-top: 16px;
    }

    .preamble {
      padding-bottom: 24px;
    }

    .preamble p {
      font-size: 17px;
      line-height: 1.55;
    }

    .post {
      gap: 9px;
      padding: 24px 0;
    }

    .post h2 {
      font-size: 25px;
    }

    .post p {
      font-size: 15px;
      line-height: 1.62;
    }

    .post__meta {
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .sidebar {
      display: none;
    }
  }
</style>
