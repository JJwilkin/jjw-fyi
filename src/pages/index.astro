---
import BaseLayout from '../layouts/BaseLayout.astro';
import { galleries, getGallery } from '../data/galleries';
import { articleUrl, formatFullDate, getArticles, isoDate } from '../lib/content';

const articles = await getArticles();
const featuredIds = ['optimizing-database-inserts', 'the-shape-of-a-queue', 'in-praise-of-slow-tools'];
const featured = featuredIds
  .map((id) => articles.find((article) => article.id === id))
  .filter((article): article is (typeof articles)[number] => Boolean(article));
---

<BaseLayout>
  <div class="home measure">
    <hr />

    <section aria-labelledby="popular-title">
      <h2 id="popular-title">popular</h2>
      {featured.map((entry) => (
        <article class="post post--featured">
          <h3><a href={articleUrl(entry)}>{entry.data.title}</a></h3>
        </article>
      ))}
      <p class="view-all"><a href="/#recent">View all&nbsp;→</a></p>
    </section>

    <hr />

    <section id="recent" aria-labelledby="recent-title">
      <h2 id="recent-title">recent</h2>
      {articles.map((entry) => {
        const gallery = getGallery(entry.data.gallery);
        return (
          <article class="post">
            <h3><a href={articleUrl(entry)}>{entry.data.title}</a></h3>
            <p class="post-meta">
              <time datetime={isoDate(entry.data.date)}>{formatFullDate(entry.data.date)}</time>
              {gallery && (
                <>
                  &nbsp;│ <a href={`/galleries/${gallery.slug}/`}>{gallery.title.toLowerCase()}</a>
                </>
              )}
            </p>
          </article>
        );
      })}
    </section>

    <nav class="older" aria-label="Browse by section" id="sections">
      <span>Browse sections: </span>
      {galleries.map((gallery, index) => (
        <>
          {index > 0 && <span>, </span>}
          <a href={`/galleries/${gallery.slug}/`}>{gallery.title.toLowerCase()}</a>
        </>
      ))}
    </nav>
  </div>
</BaseLayout>

<style>
  .home hr {
    margin-bottom: 1.75rem;
  }

  .home h2 {
    margin-bottom: 1.75rem;
  }

  .post h3 {
    margin: 0 0 0.4375rem;
  }

  .post h3 a {
    color: var(--link);
    box-shadow: none;
  }

  .post-meta {
    margin: 0 0 1.75rem;
    color: var(--ink-secondary);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .post--featured h3 {
    margin-bottom: 1.75rem;
  }

  .view-all {
    margin-top: 0.875rem;
  }

  .older {
    margin-top: 1.75rem;
  }
</style>
