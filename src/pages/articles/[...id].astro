---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plaque from '../../components/Plaque.astro';
import Connections from '../../components/Connections.astro';
import { getGallery } from '../../data/galleries';
import { getArticles, resolveConnections, galleryUrl } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const gallery = getGallery(entry.data.gallery);
const all = await getArticles();
const connections = resolveConnections(entry, all);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} type="article">
  <article class="article" data-pagefind-body>
    <div class="measure article__top">
      {
        gallery && (
          <a class="article__back" href={galleryUrl(gallery.slug)}>
            ← {gallery.title}
          </a>
        )
      }
      <Plaque
        title={entry.data.title}
        medium={entry.data.medium}
        date={entry.data.date}
        summary={entry.data.summary}
        tags={entry.data.tags}
        gallery={gallery}
      />
    </div>

    <div class="measure prose flow article__body">
      <Content />
    </div>

    <div class="measure article__foot">
      <hr class="rule-mark" />
      <Connections items={connections} />
      <nav class="article__nav" aria-label="Keep reading">
        {gallery && <a href={galleryUrl(gallery.slug)}>More in {gallery.title}</a>}
        <a href="/map/">Map of Curiosity</a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: clamp(1.4rem, 4vw, 2.4rem);
  }
  .article__back {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-faint);
    margin-bottom: 1.1rem;
  }
  .article__back:hover {
    color: var(--ink);
  }

  .article__body {
    margin-top: clamp(1.8rem, 4vw, 2.6rem);
  }

  .article__foot {
    margin-top: 1rem;
  }
  .article__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 2.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border-faint);
  }
  .article__nav a {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--link);
  }
  .article__nav a:hover {
    color: var(--link-hover);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
