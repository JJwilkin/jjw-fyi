---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioBriefing from '../../components/AudioBriefing.astro';
import Connections from '../../components/Connections.astro';
import { getGallery } from '../../data/galleries';
import {
  formatFullDate,
  getArticles,
  isoDate,
  readingMinutes,
  resolveConnections,
  tagSlug,
} from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const gallery = getGallery(entry.data.gallery);
const all = await getArticles();
const connections = resolveConnections(entry, all);
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const tags =
  entry.data.tags.length > 0 ? entry.data.tags : [gallery?.title ?? entry.data.medium];
---

<BaseLayout title={entry.data.title} description={entry.data.summary} type="article">
  <article class="article">
    <div class="article__utility">
      <a href="/">← Josh J Wilkinson</a>
      <span>
        <time datetime={isoDate(entry.data.date)}>{formatFullDate(entry.data.date)}</time>
        · {readingMinutes(entry)} min
      </span>
    </div>

    <div class="article__layout">
      <div class="article__main">
        <div class="article__topics">
          {tags.map((tag) => (
            <a href={`/tags/?tag=${encodeURIComponent(tagSlug(tag))}`}>{tag}</a>
          ))}
        </div>
        <h1>{entry.data.title}</h1>
        <p class="article__dek">{entry.data.summary}</p>

        {
          gallery?.slug === 'research' && (
            <AudioBriefing
              text={`${entry.data.title}. ${entry.data.summary}`}
              description="Hear the summary before deciding whether to read the full note."
            />
          )
        }

        <div class="prose article__body">
          <Content />
        </div>
      </div>

      <aside class="article__rail">
        {
          contents.length > 0 && (
            <nav aria-label="Article contents">
              <h2>Contents</h2>
              {contents.map((heading) => (
                <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              ))}
            </nav>
          )
        }

        {
          entry.data.tags.length > 0 && (
            <section class="filed">
              <h2>Filed under</h2>
              {entry.data.tags.map((tag) => (
                <a href={`/tags/?tag=${encodeURIComponent(tagSlug(tag))}`}>{tag}</a>
              ))}
            </section>
          )
        }
      </aside>
    </div>

    <footer class="article__foot">
      <Connections items={connections} />
      <nav aria-label="Keep reading">
        <a href="/">← All writing</a>
        <a href="/tags/">Browse tags →</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: 34px;
  }

  .article__utility {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    color: var(--ink-faint);
    font-family: var(--font-ui);
    font-size: 11px;
    line-height: 1;
  }

  .article__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: 56px;
    padding-top: 44px;
  }

  .article__main {
    min-width: 0;
  }

  .article__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 0;
  }

  .article__topics a {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.24em;
    line-height: 1;
    text-transform: uppercase;
  }

  .article__topics a + a::before {
    content: '·';
    display: inline-block;
    margin: 0 12px;
    color: var(--ink-faint);
  }

  .article h1 {
    max-width: 20ch;
    margin: 14px 0 22px;
    font-size: 46px;
  }

  .article__dek {
    max-width: 64ch;
    margin: 0 0 30px;
    color: var(--ink-secondary);
    font-size: 19px;
    font-weight: 300;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .article__body :global(> p:first-child::first-letter) {
    float: left;
    padding: 6px 12px 0 0;
    color: var(--blue-deep);
    font-size: 62px;
    font-weight: 300;
    line-height: 0.78;
  }

  .article__rail {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding-top: 64px;
  }

  .article__rail nav,
  .article__rail section {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .article__rail h2 {
    margin-bottom: 2px;
    color: var(--ink-faint);
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .article__rail nav a {
    padding-left: 9px;
    border-left: 1px solid var(--border);
    color: var(--ink-faint);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.55;
  }

  .article__rail nav a:hover {
    border-left: 2px solid var(--blue);
    color: var(--blue-deep);
  }

  .article__rail nav a.nested {
    padding-left: 18px;
  }

  .filed {
    padding: 16px;
    background: var(--paper-sunk);
  }

  .filed a {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.5;
  }

  .article__foot {
    margin-top: 52px;
    padding-top: 24px;
    border-top: 1px solid var(--blue-pale);
  }

  .article__foot > nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 30px;
    font-family: var(--font-ui);
    font-size: 11px;
  }

  @media (max-width: 760px) {
    .article {
      padding-top: 22px;
    }

    .article__utility {
      padding-bottom: 22px;
    }

    .article__layout {
      display: block;
      padding-top: 0;
    }

    .article h1 {
      margin: 12px 0 20px;
      font-size: 33px;
      line-height: 1.14;
    }

    .article__dek {
      font-size: 17px;
    }

    .article__rail {
      display: none;
    }

    .article__body :global(> p:first-child::first-letter) {
      font-size: 52px;
    }
  }
</style>
