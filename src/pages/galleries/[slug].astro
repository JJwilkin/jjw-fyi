---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AudioBriefing from '../../components/AudioBriefing.astro';
import { galleries, type Gallery } from '../../data/galleries';
import { researchRevision } from '../../data/researchRevision';
import { formatFullDate, getArticlesByGallery, isoDate } from '../../lib/content';
import { readingAudioUrl } from '../../lib/readingAudio';

export function getStaticPaths() {
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const articles = await getArticlesByGallery(gallery.slug);
const isResearch = gallery.slug === 'research';
const readingDays = isResearch
  ? [...Map.groupBy(articles, (entry) => isoDate(entry.data.date))].map(
      ([date, entries]) => ({
        date,
        entries,
        label: formatFullDate(entries[0].data.date),
        briefing: entries
          .map((entry) => `${entry.data.title}. ${entry.data.summary}`)
          .join('\n\n'),
        audio: readingAudioUrl(date),
      }),
    )
  : [];
---

<BaseLayout
  title={`${gallery.title} — ${gallery.medium}`}
  description={gallery.description}
>
  <div class="room measure" data-research-revision={isResearch ? researchRevision : undefined}>
    <hr />

    <header class="hero">
      <h2 class="hero__title">{gallery.title.toLowerCase()}</h2>
      <p>{gallery.description}</p>
    </header>

    <section aria-labelledby="articles-title">
      <h2 id="articles-title">{isResearch ? 'daily briefings' : 'posts'}</h2>
      {
        articles.length > 0 ? (
          isResearch ? (
            <div class="reading-days">
              {readingDays.map((day) => (
                <section class="reading-day" aria-labelledby={`readings-${day.date}`}>
                  <h3 id={`readings-${day.date}`} class="reading-day__date">
                    <time datetime={day.date}>{day.label}</time>
                  </h3>
                  <AudioBriefing
                    text={day.briefing}
                    src={day.audio}
                    description={`Hear this day's ${day.entries.length} reading ${day.entries.length === 1 ? 'summary' : 'summaries'}, then choose what deserves a closer read.`}
                  />
                  <div class="holdings">
                    {day.entries.map((entry) => (
                      <ArticleCard entry={entry} gallery={gallery} showSummary />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          ) : (
            <div class="holdings">
              {articles.map((entry) => (
                <ArticleCard entry={entry} gallery={gallery} />
              ))}
            </div>
          )
        ) : (
          <p>
            {isResearch ? 'Reading notes will appear here soon.' : 'Nothing here yet.'}
            {' '}Head back <a href="/">home</a>.
          </p>
        )
      }
    </section>

    <p class="room__back"><a href="/">← All posts</a></p>
  </div>
</BaseLayout>

<style>
  .room > hr {
    margin-bottom: 1.75rem;
  }

  .hero__title {
    margin-bottom: 1.75rem;
  }

  .hero {
    margin-bottom: 1.75rem;
  }

  .reading-day + .reading-day {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--blue-pale);
  }

  .reading-day__date {
    margin: 0 0 1rem;
    color: var(--blue-deep);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .room__back {
    margin-top: 1.75rem;
  }
</style>
