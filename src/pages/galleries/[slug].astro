---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { galleries, type Gallery } from '../../data/galleries';
import { getArticlesByGallery } from '../../lib/content';

export function getStaticPaths() {
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const articles = await getArticlesByGallery(gallery.slug);
---

<BaseLayout
  title={`${gallery.title} — ${gallery.medium}`}
  description={gallery.description}
>
  <div class="room measure">
    <hr />

    <header class="hero">
      <h2 class="hero__title">{gallery.title.toLowerCase()}</h2>
      <p>{gallery.description}</p>
    </header>

    <section aria-labelledby="articles-title">
      <h2 id="articles-title">posts</h2>
      {
        articles.length > 0 ? (
          <div class="holdings">
            {articles.map((entry) => (
              <ArticleCard entry={entry} gallery={gallery} />
            ))}
          </div>
        ) : (
          <p>Nothing here yet. Head back <a href="/">home</a>.</p>
        )
      }
    </section>

    <p class="room__back"><a href="/">← All posts</a></p>
  </div>
</BaseLayout>

<style>
  .room > hr {
    margin-bottom: 1.75rem;
  }

  .hero__title {
    margin-bottom: 1.75rem;
  }

  .hero {
    margin-bottom: 1.75rem;
  }

  .room__back {
    margin-top: 1.75rem;
  }
</style>
