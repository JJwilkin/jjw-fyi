---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search everything here — every article, by word."
>
  <section class="search measure">
    <header class="search__head">
      <p class="eyebrow">Index</p>
      <h1 class="search__title">Search</h1>
      <p class="search__lede">
        Every article, indexed by its words. Try a name, a place, or an idea —
        <em>databases</em>, <em>walks</em>, <em>latency</em>.
      </p>
    </header>

    <div id="search" class="pagefind-ui" data-search></div>

    <noscript>
      <p class="search__noscript">
        Search needs JavaScript. Without it, you can still browse the
        <a href="/">sections</a> or open the <a href="/map/">Map of Curiosity</a>.
      </p>
    </noscript>
  </section>
</BaseLayout>

<script is:inline>
  // Pagefind assets are generated into /pagefind during the build step
  // (`pagefind --site dist`). They are loaded on demand here so this works on
  // first load and on every view-transition navigation.
  async function initPagefind() {
    const el = document.getElementById('search');
    if (!el || el.dataset.ready) return;

    if (!window.PagefindUI) {
      if (!document.querySelector('link[data-pagefind-css]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/pagefind/pagefind-ui.css';
        link.setAttribute('data-pagefind-css', '');
        document.head.appendChild(link);
      }
      await new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = '/pagefind/pagefind-ui.js';
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      }).catch(() => {});
    }

    if (!window.PagefindUI) {
      el.innerHTML =
        '<p style="color:var(--ink-secondary)">The search index isn’t available in this preview. Run <code>npm run build</code> and serve the <code>dist/</code> output to search.</p>';
      return;
    }

    el.dataset.ready = '1';
    new window.PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      pageSize: 8,
    });
  }

  document.addEventListener('astro:page-load', initPagefind);
</script>

<style>
  .search {
    padding-top: clamp(1.8rem, 5vw, 3rem);
    min-height: 60vh;
  }
  .search__head {
    margin-bottom: clamp(1.4rem, 4vw, 2rem);
  }
  .search__title {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 2.9rem);
    line-height: 1.06;
    margin: 0.3rem 0 0;
  }
  .search__lede {
    margin-top: 0.8rem;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--ink-secondary);
  }
  .search__noscript {
    margin-top: 1.5rem;
    color: var(--ink-secondary);
  }
</style>
